# Copy to .env and fill in. .env is gitignored.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Channel is auto-discovered from the OAuth'd user's token — no need to set it.
# (Kept for backwards compat: if set, overrides the discovered channel.)
TWITCH_WATCH_CHANNEL=

TWITCH_REDIRECT_URI=https://www.autoeditor.app/atlas-clips/auth/twitch/callback

# Frontend URL — after OAuth, redirect back here with ?twitch_connected=1
FRONTEND_URL=https://www.autoeditor.app

# CORS origins (comma-separated) for the frontend
CORS_ORIGINS=https://www.autoeditor.app,http://localhost:5173,http://localhost:3000

# Category filter (case-insensitive game_name). Blank = clip any category.
TWITCH_CATEGORY_FILTER=

CLIP_SCORE_THRESHOLD=3.0
CLIP_COOLDOWN_SECONDS=30
CHAT_WINDOW_SECONDS=10
CHAT_BASELINE_MESSAGES_PER_SEC=0.5
EMOTE_SPIKE_RATIO=0.25

ENABLE_AUDIO_DETECTOR=true
AUDIO_LOUDNESS_SPIKE_DB=8.0

# Periodic fallback: clip every N seconds when live even if no hype/chat
# activity (ensures streamers with no viewers still get clips). 0 = off.
FALLBACK_CLIP_INTERVAL=300

# Also: anyone in chat can type !clip to force a clip (no config needed).

PORT=8000
